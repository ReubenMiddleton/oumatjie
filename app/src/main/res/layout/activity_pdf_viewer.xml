<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/oumatjie_background">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/oumatjie_background"
        android:elevation="4dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/back_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/pdf_back_to_mail"
            android:textAllCaps="false"
            android:textColor="@color/oumatjie_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/document_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/oumatjie_on_background"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Monthly statement.pdf" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/pdf_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/error_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/oumatjie_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/pdf_error_title"
                android:textColor="@color/oumatjie_on_background"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="12dp" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/pdf_error_message"
                android:textColor="@color/oumatjie_on_background"
                android:textSize="20sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="24dp" />

            <Button
                android:id="@+id/error_back_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/oumatjie_primary"
                android:minHeight="80dp"
                android:text="@string/pdf_back_to_mail"
                android:textAllCaps="false"
                android:textColor="@color/oumatjie_on_primary"
                android:textSize="20sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
